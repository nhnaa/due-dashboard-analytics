table GiangVien
	lineageTag: bf1791b3-1b82-42d7-85f7-bd17e88e57c0

	measure TyLe_TienSi = ```
			
			DIVIDE(
			    COUNTROWS(FILTER(GiangVien, 
			        GiangVien[HOC_VI] = "Tiến sĩ" && 
			        GiangVien[TRANG_THAI_CONG_TAC] = "Công tác bình thường")),
			    COUNTROWS(FILTER(GiangVien,
			        GiangVien[TRANG_THAI_CONG_TAC] = "Công tác bình thường"))
			)
			```
		lineageTag: 31c518c8-c662-44ba-a904-3c9e81aa17bf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure GioDayTB =
			
			CALCULATE(
			    AVERAGE(GiangVien[TONG_GIO_DAY_TRONG_NAM]),
			    GiangVien[TRANG_THAI_CONG_TAC] = "Công tác bình thường"
			)
		lineageTag: 6bfa92d1-0bdc-427c-b3a8-b10a815e8254

		annotation PBI_FormatHint = {"isGeneralNumber":true}

