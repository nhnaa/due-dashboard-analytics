	column 'GPA10 bins' =
			
			SWITCH(
			    TRUE(),
			    'QuanLy Daotao'[GPA10] >= 8.5, "8.5 - 10",
			    'QuanLy Daotao'[GPA10] >= 7.0, "7.0 - 8.4",
			    'QuanLy Daotao'[GPA10] >= 5.5, "5.5 - 6.9",
			    'QuanLy Daotao'[GPA10] >= 4.0, "4.0 - 5.4",
			    "<4.0"
			)
		lineageTag: 2c68a20c-934b-4f18-99af-3c75f4719899
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

