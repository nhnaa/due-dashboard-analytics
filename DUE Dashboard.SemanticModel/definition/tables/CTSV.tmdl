table CTSV
	lineageTag: 6e373a36-ba0d-4e1b-9180-ce3ed98908e5

	measure SLSV = DISTINCTCOUNT(CTSV[MA_SINH_VIEN])
		formatString: 0
		lineageTag: 7c287669-f7e6-4f36-b6f6-847cf6dca265

	measure '%SV theo GioiTinh' = ```
			
			VAR TotalValid = 
			    CALCULATE(
			        COUNTROWS(CTSV),
			        CTSV[GIOI_TINH] <> BLANK(),
			        CTSV[GIOI_TINH] <> ""
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        SELECTEDVALUE(CTSV[GIOI_TINH]) = "Nam", DIVIDE(CALCULATE(COUNTROWS(CTSV), CTSV[GIOI_TINH] = "Nam"), TotalValid),
			        SELECTEDVALUE(CTSV[GIOI_TINH]) = "Nữ", DIVIDE(CALCULATE(COUNTROWS(CTSV), CTSV[GIOI_TINH] = "Nữ"), TotalValid),
			        BLANK()
			    )
			```
		lineageTag: 4077901c-b2b5-4eef-8cc7-bfe9682b05fb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% SV theo Nhóm' = ```
			
			VAR SoLuongNhom = COUNT(CTSV[MA_SINH_VIEN])
			VAR TongToanTruong = 
			    CALCULATE(
			        COUNT(CTSV[MA_SINH_VIEN]),
			        ALL(CTSV)
			    )
			RETURN
			    DIVIDE(SoLuongNhom, TongToanTruong, 0)
			```
		lineageTag: 70b6a2bf-f370-4ace-a1e2-2e0d7195c806

		annotation PBI_FormatHint = {"isGeneralNumber":true}

