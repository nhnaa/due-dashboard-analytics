table 'QuanLy Daotao'
	lineageTag: fdf70a15-667c-4479-80e7-dda4d9e20a7d

	measure %Duoi_7 = ```
			
			VAR TuSo = 
			    CALCULATE(
			        COUNTROWS('QuanLy Daotao'), 
			        'QuanLy Daotao'[GPA10] < 7, 
			        NOT ISBLANK('QuanLy Daotao'[GPA10])
			    )
			
			VAR MauSo = 
			    CALCULATE(
			        DISTINCTCOUNT('QuanLy Daotao'[MA_SINH_VIEN]), 
			        NOT ISBLANK('QuanLy Daotao'[GPA10])
			    )
			
			RETURN 
			    DIVIDE(TuSo, MauSo, BLANK())
			```
		lineageTag: 18db5567-6b2e-44d8-a1ed-6a6c5a424153

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '%Tren_8.5' = ```
			
			VAR TuSo = 
			    CALCULATE(
			        COUNTROWS('QuanLy Daotao'), 
			        'QuanLy Daotao'[GPA10] > 8.5, 
			        NOT ISBLANK('QuanLy Daotao'[GPA10])
			    )
			
			VAR MauSo = 
			    CALCULATE(
			        DISTINCTCOUNT('QuanLy Daotao'[MA_SINH_VIEN]), 
			        NOT ISBLANK('QuanLy Daotao'[GPA10])
			    )
			
			RETURN 
			    DIVIDE(TuSo, MauSo, BLANK())
			```
		lineageTag: 04b023f6-cc20-412a-a198-8764a11da161

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TyLeQuaMon = ```
			
			AVERAGEX(
			    'QuanLy DaoTao', 
			    DIVIDE('QuanLy DaoTao'[SoMonDat], 'QuanLy DaoTao'[TongDangKy])
			)
			```
		lineageTag: 3edc1d63-4257-4b87-95b8-17b930df7515

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TyLeHocLai = ```
			
			DIVIDE(
			    SUM('QuanLy DaoTao'[SoHocLai]), 
			    SUM('QuanLy DaoTao'[TongDangKy])
			)
			```
		lineageTag: e0b837ce-5558-455e-97f9-b647c21ba2ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Top10_DiemTB_HP =
			
			IF(
			    RANKX(
			        ALLSELECTED(DimHocPhan[TEN_HOC_PHAN]),
			        CALCULATE(AVERAGE(HocPhan[DiemTB])),
			        ,
			        ASC
			    ) <= 10,
			    AVERAGE(HocPhan[DiemTB]),
			    BLANK()
			)
		lineageTag: ef8711e7-f710-4f2c-b18b-6348cacd8a45

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Top10_TyLeRot =
			
			IF(
			    RANKX(
			        ALLSELECTED(DimHocPhan[TEN_HOC_PHAN]),
			        CALCULATE(AVERAGE(HocPhan[TyLe_Rot])),
			        ,
			        DESC
			    ) <= 10,
			    AVERAGE(HocPhan[TyLe_Rot]),
			    BLANK()
			)
		lineageTag: 45937fa6-b488-4222-b455-6c2b5e7fb0ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

