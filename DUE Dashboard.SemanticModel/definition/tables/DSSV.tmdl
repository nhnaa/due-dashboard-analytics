table DSSV
	lineageTag: 788f1d6c-7e87-4de0-93a1-ae8c6a2f32f3

	measure TlHocLai = ```
			
			DIVIDE(
			    SUM('DSSV'[SO_MON_HOC_LAI]), 
			    SUM('DSSV'[TONG_SO_MON_DK])
			)
			```
		lineageTag: d09008a2-13d6-4a81-995c-168c67cf755f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TLThoiHoc = ```
			
			DIVIDE(
			    CALCULATE(
			        DISTINCTCOUNT(DSSV[MA_SINH_VIEN]),
			        DSSV[RA_TRUONG_DUNG_HAN] = DSSV[NAM_NHAP_HOC]
			    ),
			    CALCULATE(
			        DISTINCTCOUNT(DSSV[MA_SINH_VIEN]),
			        ISBLANK(DSSV[RA_TRUONG_DUNG_HAN]) 
			            || DSSV[RA_TRUONG_DUNG_HAN] >= DSSV[NAM_NHAP_HOC]
			    )
			)
			```
		formatString: 0
		lineageTag: 076a50bb-e006-410f-9869-1c7bb9b45f1e

	measure Tong_SV_TotNghiep =
			
			CALCULATE(
			    DISTINCTCOUNT(DSSV[MA_SINH_VIEN]),
			    DSSV[TRANG_THAI_HOC_TAP] = "Tốt nghiệp"
			)
		formatString: 0
		lineageTag: e8289598-3d25-4db9-921d-b19a17fb4750

	measure Tong_SV_DangHoc =
			
			CALCULATE(
			    DISTINCTCOUNT(DSSV[MA_SINH_VIEN]),
			    DSSV[TRANG_THAI_HOC_TAP] = "Đang học"
			)
		formatString: 0
		lineageTag: 66a9385a-09b1-4bbf-9b79-001e9849335c

