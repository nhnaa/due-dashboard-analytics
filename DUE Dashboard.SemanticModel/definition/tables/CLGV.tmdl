	column 'DIEM_HE_10 (bins)' =
			IF(
				ISBLANK('CLGV'[DIEM_HE_10]),
				BLANK(),
				IF(
					'CLGV'[DIEM_HE_10] >= 0,
					ROUNDDOWN('CLGV'[DIEM_HE_10] / 0.2, 0) * 0.2,
					ROUNDUP('CLGV'[DIEM_HE_10] / 0.2, 0) * 0.2
				)
			)
